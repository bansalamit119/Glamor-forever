// Glamour Forever - Prisma schema
//   Company  -> Employees (every employee belongs to one company)
//   Branch  <-> Employees (an employee can work at zero, one or many branches)
//   Employee -> EmployeeDocuments

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id            Int        @id @default(autoincrement())
  name          String
  companyNumber String?    // Companies House registration number
  address       String?
  phone         String?
  email         String?
  status        String     @default("Active") // "Active" | "Inactive"
  employees     Employee[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Branch {
  id        Int        @id @default(autoincrement())
  name      String
  region    String     // plain text, e.g. "Greater London", "Scotland"
  address   String?
  phone     String?
  status    String     @default("Active") // "Active" | "Inactive"
  employees Employee[] // many-to-many (Prisma manages the _BranchToEmployee join table)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Employee {
  id                               Int                @id @default(autoincrement())
  employeeNumber                   String             @unique
  firstName                        String
  lastName                         String
  email                            String?
  phoneCountryCode                 String?            // e.g. "+44"
  phone                            String?            // number without the country code
  dateOfBirth                      DateTime?          @db.Date
  address                          String?
  jobTitle                         String?
  companyId                        Int
  company                          Company            @relation(fields: [companyId], references: [id])
  branches                         Branch[]           // optional, can be several
  employmentStatus                 String             @default("Active") // Active | Inactive | On Leave | Terminated
  startDate                        DateTime?          @db.Date
  emergencyContactName             String?
  emergencyContactPhoneCountryCode String?
  emergencyContactPhone            String?
  notes                            String?
  documents                        EmployeeDocument[]
  createdAt                        DateTime           @default(now())
  updatedAt                        DateTime           @updatedAt
}

model EmployeeDocument {
  id             Int       @id @default(autoincrement())
  employeeId     Int
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType   String    // plain string so new types can be added without a migration
  documentNumber String?
  issueDate      DateTime? @db.Date
  expiryDate     DateTime? @db.Date
  fileName       String?   // original file name shown to the user
  mimeType       String?   // application/pdf | image/jpeg | image/png
  fileSize       Int?
  // The file itself is stored in the database so it survives restarts on hosts
  // without persistent disks (e.g. Render free tier). Excluded from queries by
  // default - see the global `omit` in helpers.js.
  fileData       Bytes?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
